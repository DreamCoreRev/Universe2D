<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Universe2D.AuthServer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copie config.json a cote de l'exe au build, si present (il est
         ignore par Git -- voir .gitignore -- donc absent sur un clone
         neuf tant qu'on ne l'a pas cree a partir de config.example.json). -->
    <None Include="config.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('config.json')" />
    <None Include="config.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
